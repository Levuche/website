{
  "$schema": "node_modules/wrangler/config-schema.json",
  // levuche.com on Cloudflare Workers, built with OpenNext and deployed by
  // GitHub Actions. Setup, domains and secrets: docs/DEPLOY.md. No secrets
  // belong in this file.
  "name": "levuche-com",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Next.js inlines the next-themes no-flash script into the HTML, where
  // esbuild's __name helper does not exist, so keep_names stays off.
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  // Per-address limits for the routes that call Buildbase
  // (src/lib/rate-limit.ts). namespace_id is any number unique in the
  // Cloudflare account; the dev Worker uses its own, so the two sites don't
  // share counters. Bindings aren't inherited, so env.dev repeats them.
  "ratelimits": [
    // The contact form and its spam check: 5 a minute per address.
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "47101",
      "simple": { "limit": 5, "period": 60 },
    },
    // Signing in and out: 20 a minute per address, the same as Buildbase's
    // own sign-in limit.
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "47102",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  // Production: levuche.com only (no workers.dev address). The levuche.com
  // zone must be on the same Cloudflare account before the first deploy.
  // www.levuche.com is a 301 redirect rule in the dashboard, not a route.
  "routes": [{ "pattern": "levuche.com", "custom_domain": true }],
  "workers_dev": false,
  // Keep runtime values set in the dashboard on each deploy. Secrets are
  // always kept; this also keeps any plain-text ones.
  "keep_vars": true,
  "env": {
    // The dev site: every push to the dev branch deploys here
    // (.github/workflows/deploy.yml). It reads the Buildbase development
    // environment and sends noindex. Pull requests into dev upload preview
    // versions of this Worker (.github/workflows/preview.yml), which need
    // preview_urls on. Preview links are on workers.dev and send noindex;
    // the Worker itself stays off workers.dev.
    "dev": {
      "name": "levuche-com-dev",
      "routes": [{ "pattern": "dev.levuche.com", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": true,
      "ratelimits": [
        {
          "name": "CONTACT_LIMITER",
          "namespace_id": "47201",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "AUTH_LIMITER",
          "namespace_id": "47202",
          "simple": { "limit": 20, "period": 60 },
        },
      ],
    },
  },
}
