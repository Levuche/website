# Copy to .env.local for local development. Never commit real values.
# Everything here is public (NEXT_PUBLIC_*) and inlined at build time.

# The site's own address. Canonical links, the sitemap and share images use it.
# Only https://levuche.com is indexed; any other value (a preview or staging
# host) makes the build send noindex.
NEXT_PUBLIC_SITE_URL=https://levuche.com

# Public contact addresses. Only @levuche.com addresses are accepted; until
# one is set, the pages show a [PLACEHOLDER] and /.well-known/security.txt
# answers 404. Set up the mailbox or forward before publishing an address.
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_PRIVACY_EMAIL=
# NEXT_PUBLIC_SECURITY_EMAIL=

# Where "Sign in" in the header goes (the Levuche app). Unset: no link.
# NEXT_PUBLIC_SIGN_IN_URL=

# Where the "Join the beta" form posts (field: email). Unset: the form stays
# on the page and says sign-ups aren't open yet.
# NEXT_PUBLIC_BETA_FORM_ACTION=
