# Copy to .env.local for local development. Never commit real values.
# Everything here is public (NEXT_PUBLIC_*) and inlined at build time.

# The site's own address. Canonical links, the sitemap and share images use it.
# Only https://levuche.com is indexed; any other value (a preview or staging
# host) makes the build send noindex.
NEXT_PUBLIC_SITE_URL=https://levuche.com
