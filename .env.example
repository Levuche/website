# Copy to .env.local for local development. Never commit real values.
# NEXT_PUBLIC_* values are public and inlined at build time; the others are
# server secrets: set them only in .env.local or the host's secret store
# (wrangler secret put NAME), never in this file or in wrangler.jsonc.
#
# Every Buildbase feature switches itself off while its values are missing,
# so the site builds and runs with this file copied as is.
# Setup steps: docs/BUILDBASE.md.

# The site's own address. Canonical links, the sitemap and share images use it.
# Only https://levuche.com is indexed; any other value (a preview or staging
# host) makes the build send noindex.
NEXT_PUBLIC_SITE_URL=https://levuche.com

# The dashboard (the Levuche app). Sign-in and Get started land there.
# Defaults to https://app.levuche.com; dev uses https://app-dev.levuche.com.
# NEXT_PUBLIC_APP_URL=

# Public contact addresses. All default to hello@levuche.com; only
# @levuche.com addresses are accepted.
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_PRIVACY_EMAIL=
# NEXT_PUBLIC_SECURITY_EMAIL=

# --- Buildbase: public settings ---------------------------------------------
# API host. Leave unset for https://api.console.buildbase.app.
# NEXT_PUBLIC_BUILDBASE_SERVER_URL=
# The Levuche org id (24 hex characters, console Settings).
NEXT_PUBLIC_BUILDBASE_ORG_ID=
# The development environment's key for local work and previews.
# Leave empty in production.
NEXT_PUBLIC_BUILDBASE_ENVIRONMENT=
# The sign-in client's id, and the exact redirect URL registered on it
# (http://localhost:3000 locally, https://levuche.com in production).
NEXT_PUBLIC_BUILDBASE_CLIENT_ID=
NEXT_PUBLIC_BUILDBASE_REDIRECT_URL=
# Buildbase web analytics. Off unless set to "on".
NEXT_PUBLIC_BUILDBASE_ANALYTICS=

# --- Buildbase: server secrets (never public) --------------------------------
# The sign-in client's secret. Without it sign-in stays off.
BUILDBASE_CLIENT_SECRET=
# Org API token for reading content, "<orgId>:<secret>", content-reader role.
# Without it the blog, docs, FAQs, testimonials, legal text and the home and
# pricing lists are left out.
BUILDBASE_API_TOKEN=
# Signing secret of the content webhook (/api/webhooks/content).
BUILDBASE_WEBHOOK_SECRET=
# Public id of the "Contact" form. Without it the contact form says it is
# not open yet.
BUILDBASE_CONTACT_FORM_ID=
